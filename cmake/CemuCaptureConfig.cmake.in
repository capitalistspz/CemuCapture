@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

# Prevents CMAKE_MODULE_PATH modification from escaping to the caller
block(SCOPE_FOR VARIABLES)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(libyuv MODULE)

    if (@WIN32@) # WIN32
        find_dependency(WIL MODULE)
    endif ()

    if (@cemu_capture_use_libsystemd@) # cemu_capture_use_systemd
        find_dependency(libsystemd MODULE)
    endif()

    if (@cemu_capture_use_libudev@) # cemu_capture_use_udev
        find_dependency(libudev MODULE)
    endif()
endblock()

include(${CMAKE_CURRENT_LIST_DIR}/CemuCapture-targets.cmake)
